{
  "name": "dsh-local-plugins",
  "version": "0.2.1",
  "description": "Keep locally-edited dsh plugins (third-party and core) as git repos, deploy exact commits atomically, recover from crashes, and update them from their origin.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishanshmalviya5/dsh-local-plugins.git"
  },
  "homepage": "https://github.com/ishanshmalviya5/dsh-local-plugins#readme",
  "bugs": {
    "url": "https://github.com/ishanshmalviya5/dsh-local-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "lib",
    "client/client.js",
    "scripts/undo.mjs",
    "scripts/self-deploy.sh",
    "docs/*.md",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node client/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:e2e": "node test/e2e/api-scenarios.mjs",
    "bench": "node test/bench.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run lint && npm test && npm run check:package"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
